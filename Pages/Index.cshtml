@page
@model IndexModel
@{
    Layout = null; 
    var d = Model.Data;
    var featured = d.Projects.FirstOrDefault();
    var others = d.Projects.Skip(1).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F6F1E9" />
    <title>@d.Name | Portfolio</title>
    <meta name="description" content="@d.Intro" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />
</head>
<body class="pf-body">

    @* ===================== NAV ===================== *@
    <header class="pf-container pf-nav">
        <a href="#home" class="pf-logo">@d.Name</a>
        <nav class="pf-nav__links" aria-label="Primary">
            <a href="#projects" class="pf-nav__link">Projects</a>
            <a href="#experience" class="pf-nav__link">Experience</a>
            <a href="#skills" class="pf-nav__link">Skills</a>
            <a href="#achievements" class="pf-nav__link">Achievements</a>
            <a href="#contact" class="pf-nav__link">Contact</a>
        </nav>
    </header>

    <main>

        @* ===================== HERO ===================== *@
        <section id="home" class="pf-container pf-hero">
            <div class="pf-hero__text">
                <div class="pf-badge">@d.Badge</div>
                <h1 class="pf-hero__title">Hi, I'm @d.Name</h1>
                <p class="pf-hero__intro">@d.Intro</p>
                <div class="pf-actions">
                    <a href="#projects" class="pf-btn pf-btn--primary">View projects</a>
                    <a href="#contact" class="pf-btn pf-btn--outline">Get in touch</a>
                </div>
            </div>
         <div class="pf-hero__media">
            <div class="pf-photo-wrap">
                <img src="~/img/profile.jpg" alt="Portrait of @d.Name" class="pf-photo" />
            </div>
        </div>
        </section>

        @* ===================== STATS ===================== *@
        <section class="pf-container pf-stats" aria-label="Highlights">
            @foreach (var stat in d.Stats)
            {
                <div class="pf-stat">
                    <div class="pf-stat__value">@stat.Value</div>
                    <div class="pf-stat__label">@stat.Label</div>
                </div>
            }
        </section>

        @* ===================== PROJECTS ===================== *@
        <section id="projects">
            <div class="pf-container pf-projects-head">
                <h2 class="pf-heading">Selected <em>projects</em></h2>
                <p>Academic and research work, from AI models to shipped apps.</p>
            </div>

            @if (featured != null)
            {
                <div class="pf-container">
                    <article class="pf-feature">
                        <div class="pf-feature__text">
                            <div class="pf-eyebrow">Featured · @featured.Category</div>
                            <h3 class="pf-feature__title">@featured.Title</h3>
                            <p class="pf-feature__desc">@featured.Description</p>
                            <div class="pf-chips">
                                @foreach (string tech in featured.TechStack)
                                {
                                    <span class="pf-chip">@tech</span>
                                }
                            </div>
                        </div>
                            @if (featured.Images.Any()){
                                <div class="pf-feature__media">
                                    <div class="pf-slider" data-slider role="region" aria-roledescription="carousel" aria-label="@featured.Title screenshots">
                                        <div class="pf-slider__viewport">
                                            <div class="pf-slider__track">
                                                @for (int i = 0; i < featured.Images.Count; i++)
                                                {
                                                    var img = featured.Images[i];
                                                    <div class="pf-slider__slide" role="group" aria-roledescription="slide" aria-label="@(i + 1) of @featured.Images.Count">
                                                        <img src="~/img/@img.Src" alt="@img.Alt" class="pf-slider__img" />
                                                    </div>
                                                }
                                            </div>

                                            @if (featured.Images.Count > 1)
                                            {
                                                <button type="button" class="pf-slider__btn pf-slider__btn--prev" aria-label="Previous image">&#8249;</button>
                                                <button type="button" class="pf-slider__btn pf-slider__btn--next" aria-label="Next image">&#8250;</button>
                                            }
                                        </div>

                                        @if (featured.Images.Count > 1)
                                        {
                                            <div class="pf-slider__dots">
                                                @for (int i = 0; i < featured.Images.Count; i++)
                                                {
                                                    <button type="button" class="pf-slider__dot" aria-label="Go to image @(i + 1)"></button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>}
                    </article>
                </div>
            }

            <div class="pf-container pf-cards">
                @foreach (var project in others)
                {
                    <article class="pf-card">
                        @if (project.Images.Any())
                        {
                            <div class="pf-slider" data-slider role="region" aria-roledescription="carousel" aria-label="@project.Title screenshots">
                                <div class="pf-slider__viewport">
                                    <div class="pf-slider__track">
                                        @for (int i = 0; i < project.Images.Count; i++)
                                        {
                                            var img = project.Images[i];
                                            <div class="pf-slider__slide" role="group" aria-roledescription="slide" aria-label="@(i + 1) of @project.Images.Count">
                                                <img src="~/img/@img.Src" alt="@img.Alt" class="pf-slider__img" />
                                            </div>
                                        }
                                    </div>

                                    @if (project.Images.Count > 1)
                                    {
                                        <button type="button" class="pf-slider__btn pf-slider__btn--prev" aria-label="Previous image">&#8249;</button>
                                        <button type="button" class="pf-slider__btn pf-slider__btn--next" aria-label="Next image">&#8250;</button>
                                    }
                                </div>

                                @if (project.Images.Count > 1)
                                {
                                    <div class="pf-slider__dots">
                                        @for (int i = 0; i < project.Images.Count; i++)
                                        {
                                            <button type="button" class="pf-slider__dot" aria-label="Go to image @(i + 1)"></button>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="pf-eyebrow">@project.Category</div>
                        <h3 class="pf-card__title">@project.Title</h3>
                        <p class="pf-card__desc">@project.Description</p>
                        <div class="pf-chips pf-chips--sm">
                            @foreach (var tech in project.TechStack)
                            {
                                <span class="pf-chip">@tech</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        @* ===================== EXPERIENCE ===================== *@
        <section id="experience" class="pf-band">
            <div class="pf-container">
                <h2 class="pf-heading">Working <em>experience</em></h2>
                <div>
                    @foreach (var job in d.Experience)
                    {
                        <div class="pf-job">
                            <div class="pf-job__meta">
                                @job.Duration<br />@job.Location
                            </div>
                            <div class="pf-job__body">
                                <h3 class="pf-job__title">@job.Title</h3>
                                <div class="pf-job__company">@job.Company</div>
                                <p class="pf-job__summary">@job.Summary</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        @* ===================== SKILLS ===================== *@
        <section id="skills" class="pf-container pf-skills">
            <h2 class="pf-heading">Skills &amp; <em>expertise</em></h2>
            <div class="pf-skill-list">
                @for (int g = 0; g < d.Skills.Count; g++)
                {
                    var group = d.Skills[g];
                    <div class="pf-skill-row">
                        <div class="pf-skill-row__label">@group.Title</div>
                        <div class="pf-chips">
                            @for (int i = 0; i < group.Tags.Count; i++)
                            {
                                var chipClass = g == 0 ? "pf-chip pf-chip--accent"                           // first group = main focus
                                              : (group.HighlightFirst && i == 0) ? "pf-chip pf-chip--dark"   // e.g. "Iban (Native)"
                                              : "pf-chip";
                                <span class="@chipClass">@group.Tags[i]</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ===================== ACHIEVEMENTS ===================== *@
        <section id="achievements" class="pf-band">
            <div class="pf-container pf-ach">
                <div class="pf-ach__list">
                    <h2 class="pf-heading"><em>Achievements</em></h2>
                    <div class="pf-ach__items">
                        @foreach (var a in d.Achievements)
                        {
                            <div>
                                <div class="pf-ach__label">@a.Label</div>
                                <div class="pf-ach__text">@a.Text</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="pf-ach__grid">
                    @for (int i = 0; i < d.AchievementImages.Count; i++)
                    {
                        <img src="~/img/@d.AchievementImages[i]" alt="Achievement photo @(i + 1)" class="pf-ach__img" loading="lazy" />
                    }
                </div>
            </div>
        </section>

        @* ===================== CONTACT ===================== *@
        <section id="contact" class="pf-contact">
            <div class="pf-container pf-contact__inner">
                <div class="pf-contact__text">
                    <h2 class="pf-contact__title">Let's <em>connect</em></h2>
                    <p class="pf-contact__msg">@d.Contact.Message</p>
                </div>
                <div class="pf-contact__links">
                    <a href="mailto:@d.Contact.Email" class="pf-contact__link">
                        <span class="pf-contact__label">Email</span>
                        <span class="pf-contact__value">@d.Contact.Email</span>
                    </a>
                    <a href="@d.Contact.PhoneHref" class="pf-contact__link">
                        <span class="pf-contact__label">Phone</span>
                        <span class="pf-contact__value">@d.Contact.Phone</span>
                    </a>
                    <a href="@("https://www." + d.Contact.Linkedin)" target="_blank" rel="noopener" class="pf-contact__link">
                        <span class="pf-contact__label">LinkedIn</span>
                        <span class="pf-contact__value">@d.Contact.Linkedin</span>
                    </a>
                </div>
            </div>
        </section>

    </main>
    <script src="~/js/slider.js" asp-append-version="true" defer></script>
</body>
</html>
