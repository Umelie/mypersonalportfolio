<section class="projects-section">
    <div class="container">
        <div class="project-row">
            <div class="project-text">
                <span class="project-category">Final Year Project & INDES 2026</span>
                <h3>Malaysia Sign Language Recognition</h3>
                <p class="project-desc">
                    A real-time recognition system leveraging a Hybrid CNN–LSTM Attention Network. 
                    Integrating MediaPipe Holistic for robust, high-accuracy tracking of MSL alphabets and words.
                </p>
                <div class="tech-stack">
                    <span>ASP.NET Core</span><span>TensorFlow</span><span>MediaPipe</span><span>Python</span>
                </div>
            </div>
            <div class="project-visual-stack">
                <img src="~/img/MSL-WEB1.png" class="project-static-img" alt="MSL Home"/>
                <img src="~/img/MSL-WEB2.png" class="project-static-img" alt="MSL Practice"/>
            </div>
        </div>

        <div class="project-row reverse">
            <div class="project-text">
                <span class="project-category">Mobile Development</span>
                <h3>Chatter Gen Chatbot</h3>
                <p class="project-desc">
                    Streamlining university inquiries through a Flutter-based chatbot. 
                    Utilizing ChatGPT API to provide students with real-time academic support and natural language interaction.
                </p>
                <div class="tech-stack">
                    <span>Flutter</span><span>Dart</span><span>ChatGPT API</span><span>REST API</span>
                </div>
            </div>
            <div class="project-visual-side">
                <img src="~/img/chatter1.jpg" class="project-static-img" alt="Chatbot UI 1"/>
                <img src="~/img/chatter2.jpg" class="project-static-img" alt="Chatbot UI 2"/>
            </div>
        </div>

        <div class="project-row">
            <div class="project-text">
                <span class="project-category">Full-Stack Database Systems</span>
                <h3>Oculus Sport App</h3>
                <p class="project-desc">
                    A sports facility booking solution. Architected scalable Firebase Firestore models 
                    to manage complex match scheduling and user CRUD operations securely.
                </p>
                <div class="tech-stack">
                    <span>Firebase</span><span>Node.js</span><span>Firestore</span><span>Agile</span>
                </div>
            </div>
            <div class="project-visual-side">
                <img src="~/img/oculus1.png" class="project-static-img" alt="Oculus 1"/>
                <img src="~/img/oculus2.png" class="project-static-img" alt="Oculus 2"/>
                <img src="~/img/oculus3.png" class="project-static-img" alt="Oculus 3"/>
            </div>
        </div>
    </div>
</section>

